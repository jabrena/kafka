@startuml KafkaConsumerExceptions
!theme plain
skinparam backgroundColor white
skinparam class {
    BackgroundColor lightblue
    BorderColor darkblue
    ArrowColor darkblue
}

title Kafka Consumer Exception Hierarchy

' Base Java exceptions
class RuntimeException {
    +getMessage(): String
    +getCause(): Throwable
}

class IllegalStateException {
    +IllegalStateException(message: String)
}

class IllegalArgumentException {
    +IllegalArgumentException(message: String)
}

' Kafka base exceptions
abstract class KafkaException {
    +KafkaException(message: String)
    +KafkaException(message: String, cause: Throwable)
}

abstract class ApiException {
    +ApiException(message: String)
    +ApiException(message: String, cause: Throwable)
}

abstract class RetriableException {
    +RetriableException(message: String)
    +RetriableException(message: String, cause: Throwable)
}

' Consumer-specific exceptions
class WakeupException {
    +WakeupException()
    --
    Consumer.wakeup() was called
    Used to interrupt poll() loop
}

class InterruptException {
    +InterruptException(message: String)
    +InterruptException(cause: InterruptedException)
    --
    Thread was interrupted during operation
}

class SerializationException {
    +SerializationException(message: String)
    +SerializationException(message: String, cause: Throwable)
    --
    Key/Value deserialization failed
}

class CommitFailedException {
    +CommitFailedException(message: String)
    --
    Offset commit failed due to
    rebalance or group coordination issues
}

class InvalidGroupIdException {
    +InvalidGroupIdException(message: String)
    --
    Consumer group ID is invalid
}

class NoOffsetForPartitionException {
    +NoOffsetForPartitionException(message: String)
    +getPartition(): TopicPartition
    --
    No offset found for partition
}

class OffsetOutOfRangeException {
    +OffsetOutOfRangeException(message: String)
    +getOffsets(): Map<TopicPartition, Long>
    --
    Requested offset is out of range
}

class GroupAuthorizationException {
    +GroupAuthorizationException(message: String)
    +getGroupId(): String
    --
    Not authorized for consumer group
}

class TopicAuthorizationException {
    +TopicAuthorizationException(message: String)
    +getUnauthorizedTopics(): Set<String>
    --
    Not authorized for topic operations
}

class AuthenticationException {
    +AuthenticationException(message: String)
    --
    Authentication failed
}

class UnsupportedVersionException {
    +UnsupportedVersionException(message: String)
    --
    API version not supported by broker
}

class TimeoutException {
    +TimeoutException(message: String)
    +TimeoutException(message: String, cause: Throwable)
    --
    Operation timed out
}

class InvalidTopicException {
    +InvalidTopicException(message: String)
    --
    Topic name is invalid
}

class UnknownTopicOrPartitionException {
    +UnknownTopicOrPartitionException(message: String)
    --
    Topic or partition does not exist
}

class LeaderNotAvailableException {
    +LeaderNotAvailableException(message: String)
    --
    Partition leader not available
}

class NotLeaderForPartitionException {
    +NotLeaderForPartitionException(message: String)
    --
    Broker is not leader for partition
}

class NetworkException {
    +NetworkException(message: String)
    +NetworkException(message: String, cause: Throwable)
    --
    Network I/O error
}

class CorruptRecordException {
    +CorruptRecordException(message: String)
    --
    Record failed CRC check
}

class InvalidMetadataException {
    +InvalidMetadataException(message: String)
    --
    Metadata is invalid or stale
}

class CoordinatorNotAvailableException {
    +CoordinatorNotAvailableException(message: String)
    --
    Group coordinator not available
}

class NotCoordinatorException {
    +NotCoordinatorException(message: String)
    --
    Broker is not group coordinator
}

class RebalanceInProgressException {
    +RebalanceInProgressException(message: String)
    --
    Group rebalance is in progress
}

class IllegalGenerationException {
    +IllegalGenerationException(message: String)
    --
    Consumer generation ID is invalid
}

class UnknownMemberIdException {
    +UnknownMemberIdException(message: String)
    --
    Consumer member ID is unknown
}

class FencedInstanceIdException {
    +FencedInstanceIdException(message: String)
    --
    Static consumer instance was fenced
}

class InvalidSessionTimeoutException {
    +InvalidSessionTimeoutException(message: String)
    --
    Session timeout is invalid
}

class GroupMaxSizeReachedException {
    +GroupMaxSizeReachedException(message: String)
    --
    Consumer group has reached max size
}

class MemberIdRequiredException {
    +MemberIdRequiredException(message: String)
    --
    Member ID is required for operation
}

class OffsetMetadataTooLarge {
    +OffsetMetadataTooLarge(message: String)
    --
    Offset metadata exceeds size limit
}

class RecordDeserializationException {
    +RecordDeserializationException(message: String)
    +getTopicPartition(): TopicPartition
    +getOffset(): long
    --
    Failed to deserialize record at
    specific topic-partition-offset
}

' Consumer-specific state exceptions
class InvalidConsumerStateException {
    +InvalidConsumerStateException(message: String)
    --
    Consumer is in invalid state
    for requested operation
}

class ConcurrentModificationException {
    +ConcurrentModificationException(message: String)
    --
    Consumer accessed from multiple threads
}

' Inheritance relationships
RuntimeException <|-- IllegalStateException
RuntimeException <|-- IllegalArgumentException
RuntimeException <|-- KafkaException

KafkaException <|-- ApiException
KafkaException <|-- WakeupException
KafkaException <|-- InterruptException
KafkaException <|-- SerializationException
KafkaException <|-- InvalidConsumerStateException
KafkaException <|-- ConcurrentModificationException

ApiException <|-- RetriableException
ApiException <|-- CommitFailedException
ApiException <|-- InvalidGroupIdException
ApiException <|-- NoOffsetForPartitionException
ApiException <|-- GroupAuthorizationException
ApiException <|-- TopicAuthorizationException
ApiException <|-- AuthenticationException
ApiException <|-- UnsupportedVersionException
ApiException <|-- InvalidTopicException
ApiException <|-- FencedInstanceIdException
ApiException <|-- InvalidSessionTimeoutException
ApiException <|-- GroupMaxSizeReachedException
ApiException <|-- MemberIdRequiredException
ApiException <|-- OffsetMetadataTooLarge

RetriableException <|-- OffsetOutOfRangeException
RetriableException <|-- TimeoutException
RetriableException <|-- UnknownTopicOrPartitionException
RetriableException <|-- LeaderNotAvailableException
RetriableException <|-- NotLeaderForPartitionException
RetriableException <|-- NetworkException
RetriableException <|-- CorruptRecordException
RetriableException <|-- InvalidMetadataException
RetriableException <|-- CoordinatorNotAvailableException
RetriableException <|-- NotCoordinatorException
RetriableException <|-- RebalanceInProgressException
RetriableException <|-- IllegalGenerationException
RetriableException <|-- UnknownMemberIdException

SerializationException <|-- RecordDeserializationException

note right of WakeupException
    Special exception used to interrupt
    consumer.poll() from another thread.
    Not an error condition.
end note

note right of CommitFailedException
    Indicates offset commit failed,
    usually due to rebalancing.
    Consumer should rejoin group.
end note

note right of RetriableException
    These exceptions indicate transient
    failures that may succeed if retried
    after appropriate backoff.
end note

note right of RecordDeserializationException
    Contains specific location (topic,
    partition, offset) where deserialization
    failed for targeted error handling.
end note

note right of GroupAuthorizationException
    Contains the unauthorized group ID
    for more specific error handling.
end note

note right of FencedInstanceIdException
    Static group membership feature.
    Instance was fenced by another
    consumer with same instance.id.
end note

@enduml